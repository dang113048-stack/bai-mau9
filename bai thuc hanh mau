			if(pt2.lay_ma_xe()!=ma_xe) return false;
			else{
			co2=false;
			return true;
		}
			if(pt3.lay_ma_xe()!=ma_xe) return false;
			else{
			co3=false;
			return true;
		}
	}
		bool chua(int maxe){
			if(pt1.lay_ma_xe()==maxe) return true;
			else if(pt2.lay_ma_xe()==maxe) return true;
			else if(pt3.lay_ma_xe()==maxe) return true;
