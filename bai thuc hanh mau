		void hien_thi(){
			cout<<"Ma bai:"<<ma_bai<<"Kich thuoc:"<<kich_thuoc<<" Danh sach xe hien co:"<<endl;
			if(co1==true) pt1.hien_thi();
			if(co2==true) pt2.hien_thi();
			if(co3==true) pt3.hien_thi();
		}
		bool co_loai(string loai,int*dem,double*tong){
			*dem=0; *tong=0;
			if(co1 && pt1.lay_loai_xe()==loai){
				++dem;tong+=pt1.tinh_phi();
			}
			if(co1 && pt2.lay_loai_xe()==loai){
				++dem;tong+=pt2.tinh_phi();
			}
			if(co1 && pt3.lay_loai_xe()==loai){
				++dem;tong+=pt3.tinh_phi();
			}
			return *dem>0;
		}
};
