		double tinh_phi(string loaixe,int giovao,int tgdo) {
			int phi_1h
			switch(loai_xe):
			case"Bicycle":
				phi_1h=2.00;
				break;
			case"Motocycle":
				phi_1h=4.00;
				break;
			case"Car":
				phi_1h=6.00;
				break;
			if((giovao>=6&&giovao<=9)||(giovao<=15&&giovao>=18)){
				if(tgdo<=2) tongphi+=(tgdo*(0.3*phi_1h+phi_1h));
				else tongphi+=(2*(0.3phi_1h+phi_1h));
			}
			else{
				if(tgdo<=2) tongphi+=(tgdo*(phi_1h-0.05*phi_1h));
				else tongphi+=(2*(phi_1h-0.05*phi_1h));
			}
			if(tgdo>2) tongphi+=(phi_1h-0.1*phi_1h)*(tgdo-2);
			return tongphi;
		}
		void hien_thi(){
			cout<<"Ma xe:"<<ma_xe<<"Loai xe:"<<loai_xe<<endl;
		}
};
class bai_xe{
